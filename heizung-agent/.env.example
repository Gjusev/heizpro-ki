# Voice provider (ElevenLabs conversational agent)
ELEVENLABS_API_KEY=your_key
ELEVENLABS_MODEL_ID=elevenlabs_turbo_v2
ELEVENLABS_SPEECH_ENGINE_ID=your_engine
